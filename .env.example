# Copy this to .env and fill in a real key. .env is gitignored.
# The agent + judges default to Groq-hosted models (see configs/defaults.yaml),
# so GROQ_API_KEY is what you need for a default run.
GROQ_API_KEY=

# Optional: the harness is provider-agnostic. Uncomment and set any of these to
# run a judge (or the agent) on another provider — e.g. a Claude cross-check.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
